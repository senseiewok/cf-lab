{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.ppk)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials.json)",
      "Read(**/*service-account*.json)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(rm *)",
      "PowerShell(Remove-Item *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(curl.exe *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(npm install *)",
      "Bash(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(pip install *)",
      "PowerShell(winget install *)",
      "Edit(AGENTS.md)",
      "Edit(.github/copilot-instructions.md)",
      "Edit(.claude/**)"
    ]
  }
}
