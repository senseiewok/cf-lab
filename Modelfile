FROM qwen3.8:27b

# Context window. Ollama defaults to 4096.
PARAMETER num_ctx 32768

# Non-thinking ("fast") sampling recommended by the Qwen3.8 model card
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 1.5

